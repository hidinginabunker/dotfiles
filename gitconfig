[core]
	editor = vim
	excludesfile = ~/.gitignore
[user]
	# Never guess an identity: it comes from ~/.gitconfig.local (included at the end).
	useConfigOnly = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[fetch]
	prune = true
[push]
	# Push the current branch to the branch of the same name; never to whatever it tracks
	# (tracking can fast-forward main from a feature branch).
	default = simple
	autoSetupRemote = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[color "branch"]
	current = red
	local = blue
	remote = cyan
[color "diff"]
	meta = magenta bold
	frag = magenta bold
	plain = green bold
	old = red bold
	new = yellow bold
[color "status"]
	header = magenta bold
	added = green bold
	updated = green bold
	changed = yellow bold
	untracked = red bold
[url "git@github.com:"]
	insteadOf = https://github.com/
[alias]
	hist = log --pretty=format:\"%C(yellow)%h %Cgreen%ad %C(yellow)%ae%Creset %s%C(red)%d%Creset\" --graph --date=short
	s = status
	ph = push origin HEAD
	c = commit -m
	amend = commit --amend --no-edit
# Identity (name, email) and anything else per machine. Last, so it wins.
[include]
	path = ~/.gitconfig.local
